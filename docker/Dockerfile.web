# Production static build for @raid/web, served by nginx. Build from the repo root:
#   docker build -f docker/Dockerfile.web -t raid-web --build-arg VITE_SERVER_URL=https://api.example.com .
FROM node:22-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @raid/web...

FROM deps AS build
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=$VITE_SERVER_URL
COPY packages/shared packages/shared
COPY apps/web apps/web
COPY tsconfig.base.json tsconfig.base.json
RUN pnpm --filter @raid/shared run build && pnpm --filter @raid/web run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
