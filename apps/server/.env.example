# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raid_dev

# Must match the web app's origin for CORS + cookies
CORS_ORIGIN=http://localhost:5173

SESSION_COOKIE_NAME=raid_session
SESSION_TTL_DAYS=7

# "mock" (default, no API calls, safe for dev/tests) or "deepseek"
AI_PROVIDER=mock

# Only required when AI_PROVIDER=deepseek. Server-side only — never exposed to the client.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

LOG_LEVEL=info
